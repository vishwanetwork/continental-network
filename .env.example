# Public URL used after Google OAuth has completed.
PUBLIC_APP_URL=https://agent-flow.test.vishwalab.com

# Optional. When omitted, this is derived as:
# ${PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://agent-flow.test.vishwalab.com/api/auth/google/callback

# Configure the remaining values only through the 1Panel environment-variable UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZHIPU_API_KEY=
NEXT_PUBLIC_DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
